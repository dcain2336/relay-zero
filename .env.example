# Free model seat keys — NEVER commit real values. Copy to .env and fill in.
# All seats are FREE tiers. The agent treats seats as disposable: bench() probes
# at startup and only routes to seats that answer.

# Core bench
GROQ_API_KEY=
MISTRAL_API_KEY=
NOUS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# NOTE: SambaNova was dropped from the bench (2026-10-10): the free tier
# blocks inference with HTTP 429/402 until a payment method is on file, which
# violates the entry's no-billing rule. bench() would mark it dead anyway.
SAMBANOVA_API_KEY=  # unused: see note above (inference gated behind billing)
GEMINI_API_KEY=

# neatlogs tracing (optional: traces buffer locally when unset)
NEATLOGS_API_KEY=

# Demo controls
# RELAYZERO_KILL_SEAT=groq      # simulate a dead seat (HTTP 500) for kill tests
# RELAYZERO_NO_VERIFY=1         # skip the verifier pass
