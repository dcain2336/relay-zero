# Free model seat keys — NEVER commit real values. Copy to .env and fill in.
# All seats are FREE tiers. The agent treats seats as disposable: bench() probes
# at startup and only routes to seats that answer.

# Core bench
GROQ_API_KEY=
MISTRAL_API_KEY=
NOUS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
GEMINI_API_KEY=

# neatlogs tracing (optional: traces buffer locally when unset)
NEATLOGS_API_KEY=

# Demo controls
# RELAYZERO_KILL_SEAT=groq      # simulate a dead seat (HTTP 500) for kill tests
# RELAYZERO_NO_VERIFY=1         # skip the verifier pass
